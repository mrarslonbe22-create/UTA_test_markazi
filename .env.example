# Nusxa oling: cp .env.example .env  va qiymatlarni to'ldiring
PORT=3000

# Birinchi ADMIN (EGA) akkaunti. Admin hali yo'q bo'lsa avtomatik yaratiladi.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=bu_yerga_kuchli_parol

# Sessiya kaliti (ixtiyoriy; bo'sh bo'lsa avtomatik yaratiladi va bazada saqlanadi)
JWT_SECRET=

# AI (ixtiyoriy; buni Admin -> Sozlamalar -> AI bo'limidan ham kiritish mumkin)
# AI_PROVIDER: gemini, groq, openrouter, xai, openai, deepseek, anthropic yoki custom
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Ma'lumotlar bazasi papkasi (deploy qilganda doimiy disk yo'lini bering)
DATA_DIR=./data

# Demo fanlar/testlarni birinchi ishga tushirishda yaratish (false = yaratmaslik)
SEED_DEMO=true
